# =====================================================================
# MEMETEK Telegram Community Bot — Environment Configuration Template
# =====================================================================

# ---------------------------------------------------------------------
# 1. Telegram Bot Credentials
# ---------------------------------------------------------------------
# Obtain this token from @BotFather on Telegram (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Optional Webhook Configuration (if left empty or false, long polling is used)
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com/telegram/webhook
WEBHOOK_SECRET=your_super_secret_webhook_token_here

# ---------------------------------------------------------------------
# 2. Database & Cache
# ---------------------------------------------------------------------
# Production PostgreSQL connection string (asyncpg driver)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://memetek_user:memetek_secure_pass@postgres:5432/memetek_db

# For quick local testing without PostgreSQL, SQLite can be used:
# DATABASE_URL=sqlite+aiosqlite:///./memetek.db

# Redis connection string for caching, rate-limiting, and flood control
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------
# 3. Access Control & Authorization
# ---------------------------------------------------------------------
# Comma-separated list of numeric Telegram User IDs for Global Bot Superadmins
# Example: 123456789,987654321
ADMIN_USER_IDS=123456789

# Comma-separated list of Telegram Chat IDs the bot is authorized to operate in
# If empty, the bot operates in any chat it is invited to (or where it is an admin)
ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------------
# 4. Web Dashboard & Healthcheck API
# ---------------------------------------------------------------------
# Dashboard / API server binding
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Web Dashboard credentials & JWT secret
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ChangeMeInProductionDegen123!
DASHBOARD_SECRET_KEY=change_this_to_a_random_32_byte_secret_key_here

# ---------------------------------------------------------------------
# 5. External APIs & Market Data
# ---------------------------------------------------------------------
# CoinGecko Demo/Pro API key (optional - public endpoints work without key if within rate limits)
COINGECKO_API_KEY=

# Default crypto assets supported for quick lookup
SUPPORTED_SYMBOLS=BTC,ETH,SOL,DOGE,PEPE,SHIB,BONK,WIF,FLOKI

# Cache duration for market data in seconds (to respect rate limits)
MARKET_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------
# 6. Community & Anti-Spam Defaults
# ---------------------------------------------------------------------
# Default auto-delete time for welcome messages in seconds (0 = disabled)
DEFAULT_WELCOME_AUTO_DELETE_SECONDS=120

# Max messages allowed within the flood window before warning/restricting
FLOOD_MAX_MESSAGES=5
FLOOD_WINDOW_SECONDS=5

# Warnings threshold before automated temporary mute (e.g. 3 warnings = 2h mute)
MAX_WARNINGS_BEFORE_MUTE=3
MUTE_DURATION_MINUTES=120

# ---------------------------------------------------------------------
# 7. Application Runtime & Observability
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
TIMEZONE=UTC
APP_ENV=production
TEST_MODE=false
